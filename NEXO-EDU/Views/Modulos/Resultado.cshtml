@using NEXO_EDU.Services
@using NEXO_EDU.Models
@{
    ViewData["Title"] = "Mis resultados";
}
<link rel="stylesheet" href="~/css/nexo-modulos.css" asp-append-version="true" />
@model RevisionLeccionNexo
@{
    var css = Model.Leccion.Nivel == "secundaria" ? "secondary" : Model.Leccion.Nivel == "preparatoria" ? "prepa" : "";
}
<div class="module-page @css">
    <div class="module-top"><a class="module-back" asp-action="Biblioteca">← Regresar a mis materias</a><span class="module-tag">@Model.Leccion.Materia</span></div>
    <section class="module-hero"><span class="module-tag">RESULTADOS Y RETROALIMENTACIÓN</span><h1 class="module-title">@Model.Aciertos de @Model.Total respuestas correctas</h1><p class="module-subtitle">@Model.Recomendacion</p>
      <div class="module-summary"><div class="module-stat"><strong>@Model.Porcentaje%</strong> aciertos</div><div class="module-stat"><strong>+@Model.Experiencia</strong> XP</div></div>
    </section>
    <h2>Aprende de cada respuesta</h2>
    @foreach(var r in Model.Respuestas)
    {
       <article class="module-result @(r.Acertada ? "correct" : "review")"><strong>@(r.Acertada ? "✓ Correcto" : "↻ Para repasar") · @r.Numero. @r.Enunciado</strong><p>Respuesta correcta: <strong>@r.Correcta</strong></p><p>@r.Explicacion</p></article>
    }
    <div class="module-actions"><a class="module-action" asp-action="Resolver" asp-route-clave="@Model.Leccion.Clave">Volver a practicar</a><a class="module-outline" asp-action="Biblioteca">Explorar otra materia</a></div>
    <p class="module-info">Los puntos de esta actividad se acumulan en esta sesión; la persistencia en PostgreSQL se implementará en una etapa posterior.</p>
</div>
