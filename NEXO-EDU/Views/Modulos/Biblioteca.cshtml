@using NEXO_EDU.Services
@using NEXO_EDU.Models
@model IReadOnlyList<LeccionNexo>
@{
    ViewData["Title"] = "Biblioteca de aprendizaje";
    var nivel = (string?)ViewBag.Nivel ?? "primaria";
    var nombre = (string?)ViewBag.Nombre ?? "Estudiante";
    var progreso = ViewBag.Progreso as ProgresoDemo ?? new ProgresoDemo();
    var css = nivel == "secundaria" ? "secondary" : nivel == "preparatoria" ? "prepa" : "";
    var superados = Model.Sum(m => Math.Max(0, DemoProgressService.MaximoDesbloqueado(progreso, m.Clave) - 1));
}
<div class="module-page @css">
  <div class="module-top"><a class="module-back" asp-controller="NexoDemo" asp-action="Estudiante">← Volver a mi espacio</a><span class="module-tag">@NivelDemo.Nombre(nivel)</span></div>
  <section class="module-hero">
    <span class="module-tag">NEXO LEARN · 5 NIVELES POR MATERIA</span>
    <h1 class="module-title">¡Hola, @nombre! Tu aventura continúa.</h1>
    <p class="module-subtitle">Elige una materia y supera cinco niveles con retos nuevos, explicaciones y logros. Cada materia avanza a tu ritmo.</p>
    <div class="module-summary">
      <div class="module-stat"><strong>@Model.Count</strong> materias</div>
      <div class="module-stat"><strong>@superados / @(Model.Count*5)</strong> niveles superados</div>
      <div class="module-stat"><strong>@progreso.Xp</strong> XP acumulados</div>
    </div>
  </section>
  <div class="module-grid">
    @foreach(var modulo in Model)
    {
      var siguiente = DemoProgressService.MaximoDesbloqueado(progreso, modulo.Clave);
      var aprobados = progreso.NivelesSuperados?.GetValueOrDefault(modulo.Clave,0) ?? 0;
      <article class="module-card module-card--path">
        <span class="module-icon" aria-hidden="true">@modulo.Icono</span><span class="module-category">@modulo.Materia</span>
        <h2>@modulo.Titulo</h2><p>@modulo.Descripcion</p>
        <div class="module-path-dots" aria-label="@aprobados de 5 niveles completados">
          @for(var n=1;n<=5;n++){<span class="@(n <= aprobados ? "done" : n == siguiente ? "active" : "locked")" title="Nivel @n">@(n <= aprobados ? "✓" : n.ToString())</span>}
        </div>
        <div class="module-progress-line"><span style="width:@(aprobados*20)%"></span></div>
        <small>@(aprobados==5 ? "Ruta terminada · ¡Felicidades!" : $"Nivel {siguiente} disponible de 5")</small>
        <a class="module-action" asp-action="Ruta" asp-route-clave="@modulo.Clave">@(aprobados==5 ? "Repasar mis niveles →" : "Continuar mi ruta →")</a>
      </article>
    }
  </div>
  <p class="module-info">Aprendizaje de demostración: Niveles, XP y logros se guardan en PostgreSQL al usar el perfil PostgreSQL; el modo Demo local conserva el progreso temporal.</p>
</div>