@model NEXO_EDU.Models.RegistroDocenteModel
@{
 ViewData["Title"]="Registro de docente";
}
<link rel="stylesheet" href="~/css/nexo-matricula.css" asp-append-version="true"/>
<section class="matricula-page">
 <div class="matricula-shell">
  <a class="matricula-back" asp-controller="Cuenta" asp-action="Ingresar">← Ya tengo una cuenta</a>
  <div class="matricula-heading"><span class="matricula-kicker">NEXO EDU · CUENTAS DOCENTES</span><h1>Comienza tu aula digital</h1><p>Crea tu cuenta con un código de invitación entregado por tu institución. Después podrás registrar a tus estudiantes de forma segura.</p></div>
  <form class="matricula-form" asp-action="RegistroDocente" method="post">
   @Html.AntiForgeryToken()
   <div asp-validation-summary="All" class="matricula-error" role="alert"></div>
   <div class="matricula-fields">
    <div><label asp-for="Nombre"></label><input asp-for="Nombre" autocomplete="name" required maxlength="120"/></div>
    <div><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" required maxlength="256"/></div>
    <div><label asp-for="Institucion"></label><input asp-for="Institucion" required maxlength="140"/></div>
    <div><label asp-for="Nivel"></label><select asp-for="Nivel"><option value="primaria">Primaria</option><option value="secundaria">Secundaria</option><option value="preparatoria">Preparatoria</option></select></div>
    <div><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" required minlength="12"/></div>
    <div><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" required/></div>
    <div class="matricula-wide"><label asp-for="CodigoInvitacion"></label><input asp-for="CodigoInvitacion" autocomplete="off" required/><small>El registro no está abierto al público. Solicita el código a quien administra el proyecto.</small></div>
   </div>
   <button type="submit" class="matricula-button">Crear mi cuenta docente →</button>
  </form>
 </div>
</section>