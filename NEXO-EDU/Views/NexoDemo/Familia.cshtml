@{
    ViewData["Title"] = "Seguimiento familiar";
    ViewData["Immersive"] = true;
    var nivel = (string?)ViewBag.Nivel ?? "primaria";
    ViewData["CurrentLevel"] = nivel;
    ViewData["LevelAction"] = "Familia";
    ViewData["LevelRole"] = "Familia";
}
<div class="level-experience @(nivel == "primaria" ? "theme-primary" : nivel == "secundaria" ? "theme-secondary" : "theme-prepa")">
<div class="level-app-shell">
    <partial name="_LevelSidebar"/>
    <main class="level-main">
        <div class="level-page-top"><span>Hola, Lucía</span><span>Semana del 2 al 8 de noviembre · Datos de ejemplo</span></div>
        <div class="level-preview"><small>Ver diseño por nivel</small><partial name="_LevelSwitcher"/></div>
        @if (nivel == "primaria")
        {
            <div class="level-heading family-heading"><h1>Así va la aventura de Leo</h1><p>Pequeños descubrimientos, a su ritmo.</p></div>
            <section class="family-feature"><div><span class="tiny-caps">ESTA SEMANA</span><h2>3 de 4 aventuras completadas</h2><div class="family-feature-progress"><span></span></div><p>✓ Ya reconoce los números hasta el 20.</p><span class="violet-link">Su aprendizaje · Vista de ejemplo</span></div><div class="family-mascot" aria-label="NEXO PET, compañero de Leo"><span class="mini-mascot">✦</span><div class="mascot-badge">♙ Gran explorador</div></div></section>
            <section class="family-together"><div class="section-row"><h2>Un ratito juntos</h2><small>Sin pantallas · 5 minutos</small></div><div class="together-item"><div class="hand-illustration">♧</div><div><h3>¿Cuántos tesoros hay en casa?</h3><p>Buscad 10 objetos y contadlos juntos. Jugar con lo cotidiano ayuda a practicar las sumas.</p></div><span class="soft-pill">Actividad familiar</span></div></section>
            <section class="family-message"><div class="section-row"><h2>Un mensaje de su profe</h2><small>Hoy, 10:30 · Ejemplo</small></div><div class="teacher-message"><span class="initial-circle green">CR</span><div><strong>Clara Ruiz</strong><p>«Leo está participando con muchas ganas. Esta semana seguiremos practicando las sumas. ¡Gracias por acompañarlo!»</p><span class="violet-link">Mensajería · Próximamente</span></div></div></section>
        }
        else
        {
            <div class="level-heading"><h1>@(nivel == "secundaria" ? "Acompaña el progreso de Sofía" : "Acompañamiento con autonomía")</h1><p>@(nivel == "secundaria" ? "2.º de secundaria · Seguimiento del aprendizaje" : "Preparatoria · Metas académicas compartidas con respeto a la privacidad")</p></div>
            <section class="level-banner"><div><span class="tiny-caps">RESUMEN DEL PERIODO</span><h2>@(nivel == "secundaria" ? "Cada avance es una oportunidad" : "Avanzando hacia nuevas metas")</h2><p>@(nivel == "secundaria" ? "Celebra sus logros y ayuda a reforzar las dificultades." : "Acompaña sus decisiones educativas sin sustituir su autonomía.")</p><div class="progress-meter"><span style="width:76%"></span></div><small>76% del plan · dato ilustrativo</small></div><div class="banner-symbol">♡</div></section>
            <div class="level-metrics"><article><span>ACTIVIDADES</span><strong>8/10</strong><small>Periodo actual</small></article><article><span>FORTALEZAS</span><strong>3</strong><small>Conceptos logrados</small></article><article><span>APOYOS SUGERIDOS</span><strong>1</strong><small>Consultar con el docente</small></article></div>
            <div class="level-two-cols"><article class="level-white-card"><h2>¿Cómo puedo apoyar?</h2><p>@(nivel == "secundaria" ? "Conversen sobre el tema que está estudiando y acuerden horarios de práctica sin presiones." : "Escucha sus objetivos, reconoce sus decisiones y ofrece ayuda cuando la solicite.")</p><div class="note-box">El esfuerzo y la mejora son más importantes que una sola calificación.</div></article><article class="level-white-card"><h2>Comunicación con la escuela</h2><p>Un espacio para recibir avisos y coordinar apoyos educativos.</p><span class="route-tag neutral">Mensajería · Próximamente</span></article></div>
        }
    </main>
</div>
</div>
