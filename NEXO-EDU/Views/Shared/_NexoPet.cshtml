@using NEXO_EDU.Services
@{
    var nivelPet = ViewData["PetLevel"]?.ToString() ?? ViewData["CurrentLevel"]?.ToString() ?? ViewBag.Nivel as string ?? "primaria";
    var mascota = MascotasNexo.ParaNivel(nivelPet);
    var etapa = int.TryParse(ViewData["PetStage"]?.ToString(), out var etapaDeseada) ? Math.Clamp(etapaDeseada, 1, 3) : 1;
    var compacta = ViewData["PetCompact"]?.ToString() == "true";
    var nombreEtapa = mascota.Etapas[etapa - 1].Nombre;
}
<div class="nexo-mascot nexo-mascot--@mascota.Clave @(compacta ? "nexo-mascot--compact" : "")"
     data-mascot="@mascota.Clave" data-stage="@etapa" tabindex="0" role="group"
     aria-label="@mascota.Nombre, etapa @etapa, @nombreEtapa">
    <div class="nexo-mascot__aura" aria-hidden="true"></div>
    <div class="nexo-mascot__spark nexo-mascot__spark--a" aria-hidden="true">✦</div>
    <div class="nexo-mascot__spark nexo-mascot__spark--b" aria-hidden="true">✧</div>
    <div class="nexo-mascot__model">
        <img src="~/img/pets/@(mascota.Clave)-@(etapa).svg" alt="@mascota.Nombre · @nombreEtapa"
             width="420" height="440" loading="eager" draggable="false" />
    </div>
    <div class="nexo-mascot__shadow" aria-hidden="true"></div>
    <div class="nexo-mascot__speech" role="status" aria-live="polite"></div>
</div>