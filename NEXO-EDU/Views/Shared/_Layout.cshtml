<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#6a53ce"/>
    <title>@ViewData["Title"] · NEXO EDU</title>
    <link rel="stylesheet" href="~/css/nexo-ui.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/nexo-auth.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/nexo-levels.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/nexo-login-v2.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/nexo-pet-purple.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/nexo-levels-v2.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/nexo-modulos.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/nexo-pets-studio.css" asp-append-version="true"/>
    <script src="~/js/nexo-pet.js" asp-append-version="true" defer></script>
    <link rel="stylesheet" href="~/css/nexo-pet-companion.css" asp-append-version="true"/>
    <script src="~/js/nexo-pet-companion.js" asp-append-version="true" defer></script>
    <link rel="stylesheet" href="~/css/nexo-premium-ui.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/nexo-login-premium.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/nexo-login-motion.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/nexo-validacion.css" asp-append-version="true"/>
    <script src="~/js/nexo-validacion.js" asp-append-version="true" defer></script>
</head>
<body>
@if (ViewData["Immersive"] is not true)
{
    <header class="topbar">
        <a class="brand" asp-controller="NexoDemo" asp-action="Index" aria-label="Inicio de NEXO EDU"><span class="brand-symbol">N</span><span>NEXO <em>EDU</em></span></a>
        <nav class="main-nav" aria-label="Navegación">
            <a asp-controller="NexoDemo" asp-action="Index">Inicio</a>
            @if (User.IsInRole("Alumno"))
            {
                <a asp-controller="NexoDemo" asp-action="Estudiante">Mi aprendizaje</a>
                <a asp-controller="NexoDemo" asp-action="Mascota">NEXO PET</a>
            }
            @if (User.IsInRole("Docente")) { <a asp-controller="NexoDemo" asp-action="Docente">Mi aula</a> }
            @if (User.IsInRole("Familia")) { <a asp-controller="NexoDemo" asp-action="Familia">Familia</a> }
        </nav>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Cuenta" asp-action="Salir" method="post">
                @Html.AntiForgeryToken()
                <button class="nav-cta logout-btn" type="submit">Cerrar sesión</button>
            </form>
        }
        else
        {
            <a class="nav-cta" asp-controller="Cuenta" asp-action="Ingresar">Iniciar sesión →</a>
        }
    </header>
}
<main id="contenido">@RenderBody()</main>
@if (User.IsInRole("Alumno") && ViewData["PetCompanionDisabled"] is not true)
{
    <partial name="_PetCompanion"/>
}
@if (ViewData["Immersive"] is not true)
{
    <footer class="site-footer"><span>© 2026 NEXO EDU · Conectamos talento. Transformamos el aprendizaje.</span><span>Prototipo · Datos ficticios</span></footer>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>