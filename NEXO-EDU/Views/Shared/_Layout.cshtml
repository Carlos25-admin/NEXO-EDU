<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a57cb" />
    <title>@ViewData["Title"] · NEXO EDU</title>
    <link rel="stylesheet" href="~/css/nexo-ui.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="NexoDemo" asp-action="Index" aria-label="Ir al inicio de NEXO EDU">
            <span class="brand-symbol">N</span><span>NEXO <em>EDU</em></span>
        </a>
        <nav class="main-nav" aria-label="Navegación principal">
            <a asp-controller="NexoDemo" asp-action="Index">Inicio</a>
            <a asp-controller="NexoDemo" asp-action="Estudiante">Estudiante</a>
            <a asp-controller="NexoDemo" asp-action="Docente">Docente</a>
            <a asp-controller="NexoDemo" asp-action="Familia">Familia</a>
            <a asp-controller="NexoDemo" asp-action="Mascota">NEXO PET</a>
        </nav>
        <a class="nav-cta" asp-controller="NexoDemo" asp-action="Diagnostico">Iniciar diagnóstico →</a>
    </header>
    <main id="contenido">@RenderBody()</main>
    <footer class="site-footer"><span>© 2026 NEXO EDU · Conectamos talento. Transformamos el aprendizaje.</span><span>Prototipo Hack4Edu · Datos de demostración</span></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
